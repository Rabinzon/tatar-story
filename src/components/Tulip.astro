---
/** Ләлә — тюльпан татарской вышивки. Единственный орнамент сайта. */
interface Props { size?: number; class?: string; }
const { size = 20, class: cls = '' } = Astro.props;
---
<svg class={`tulip ${cls}`} style={`width:${size}px;height:${Math.round(size * 1.3)}px`}
     viewBox="0 0 24 32" aria-hidden="true" focusable="false">
  <path d="M12 31V15" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" fill="none" />
  <path d="M12 26c-5 0-9-3.6-9-9 5 0 9 3.6 9 9zM12 26c5 0 9-3.6 9-9-5 0-9 3.6-9 9z"
        fill="currentColor" opacity=".45" />
  <path d="M12 17c-5.5 0-8-4.4-8-8.2C4 4.2 7.6 1 12 1s8 3.2 8 7.8C20 12.6 17.5 17 12 17z"
        fill="currentColor" />
  <path d="M12 16V3M8 15.2c-.8-3.4-.6-7 .8-10M16 15.2c.8-3.4.6-7-.8-10"
        stroke="var(--paper)" stroke-width="1.1" fill="none" opacity=".75" />
</svg>
