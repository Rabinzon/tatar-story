---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Tulip from '../components/Tulip.astro';
import ReaderSettings from '../components/ReaderSettings.astro';
import { readingStats, formatWords } from '../lib/reading';
import { TAGS } from '../lib/tags';
import { url } from '../lib/url';

const tales = (await getCollection('tales'))
  .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title, 'ru'))
  .map((tale) => ({ ...tale, stats: readingStats(tale.body ?? '') }));

const featured = tales.find((tale) => tale.data.featured) ?? tales[0];
const rest = tales.filter((tale) => tale.id !== featured?.id);

const used = new Set(tales.flatMap((tale) => tale.data.tags));
const chips = TAGS.filter((tag) => tag.key === 'all' || used.has(tag.key));

const haystack = (tale: (typeof tales)[number]) =>
  `${tale.data.title} ${tale.data.titleRu} ${tale.data.kind}`.toLowerCase();
---

<Base title="Әкиятләр китапханәсе">
  <header class="mast wrap">
    <div class="brand" style="justify-content:space-between;width:100%">
      <span style="display:flex;align-items:baseline;gap:.55rem">
        <Tulip size={26} class="mark" />
        <span class="eyebrow">Татар халык иҗаты</span>
      </span>
      <button type="button" class="tb-btn" data-open-settings aria-haspopup="dialog">Уку</button>
    </div>
    <h1>Әкиятләр китапханәсе</h1>
    <p>Татар халык әкиятләрен уку өчен тыныч урын. Реклама юк, комачаулау юк — тик текст кына.</p>
  </header>

  <div class="tools wrap">
    <label class="search">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path>
      </svg>
      <input type="search" data-search placeholder="Әкият эзләү…" aria-label="Әкият эзләү" />
    </label>
    <div class="chips" role="group" aria-label="Тематика">
      {chips.map((tag, i) => (
        <button type="button" class="chip" data-tag={tag.key} aria-pressed={i === 0 ? 'true' : 'false'}>
          {tag.label}
        </button>
      ))}
    </div>
  </div>

  <main class="shelf wrap" id="main">
    {featured && (
      <a class="lead-card" href={url(`/${featured.id}/`)}
         data-tags={featured.data.tags.join(' ')} data-title={haystack(featured)}>
        <span class="badge"><Tulip size={11} /> Атна әкияте</span>
        <h3>{featured.data.title}</h3>
        <div class="ru" lang="ru">{featured.data.titleRu}</div>
        <p>{featured.data.summary}</p>
        <div class="meta">
          <span>{featured.stats.minutes} минут уку</span><span class="dot"></span>
          <span>{featured.data.kind}</span><span class="dot"></span>
          <span>{formatWords(featured.stats.words)} сүз</span>
        </div>
      </a>
    )}

    <h2>Барлык әкиятләр</h2>
    <div data-list>
      {rest.map((tale) => (
        <a class="tale" href={url(`/${tale.id}/`)}
           data-tags={tale.data.tags.join(' ')} data-title={haystack(tale)}>
          <div>
            <h3>{tale.data.title}</h3>
            <div class="ru" lang="ru">{tale.data.titleRu}</div>
          </div>
          <div class="len">{tale.stats.minutes} мин</div>
        </a>
      ))}
    </div>
    <p class="empty" data-empty hidden>Андый әкият табылмады.</p>
  </main>

  <footer class="foot wrap">
    <p>Текстлар халык иҗатыннан. Һәр әкият янында чыганагы күрсәтелә.</p>
  </footer>

  <ReaderSettings />
</Base>

<script>
  const search = document.querySelector<HTMLInputElement>('[data-search]');
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.chip'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-title]'));
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  let tag = 'all';

  function filter() {
    const query = (search?.value ?? '').trim().toLowerCase();
    let shown = 0;
    for (const card of cards) {
      const tags = (card.dataset.tags ?? '').split(' ');
      const matchesTag = tag === 'all' || tags.includes(tag);
      const matchesQuery = !query || (card.dataset.title ?? '').includes(query);
      card.hidden = !(matchesTag && matchesQuery);
      if (!card.hidden) shown++;
    }
    if (empty) empty.hidden = shown > 0;
  }

  search?.addEventListener('input', filter);
  for (const chip of chips) {
    chip.addEventListener('click', () => {
      tag = chip.dataset.tag ?? 'all';
      for (const other of chips) other.setAttribute('aria-pressed', String(other === chip));
      filter();
    });
  }
</script>
